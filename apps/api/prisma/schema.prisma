generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(320)
  passwordHash String    @map("password_hash") @db.VarChar(100)
  sessions     Session[]
  projects     Project[]
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model Project {
  id          String          @id @default(uuid()) @db.Uuid
  ownerId     String          @map("owner_id") @db.Uuid
  name        String          @db.VarChar(120)
  startDate   DateTime        @map("start_date") @db.Date
  endDate     DateTime        @map("end_date") @db.Date
  excludeNonWorkingDays Boolean @default(true) @map("exclude_non_working_days")
  publicToken String          @unique @map("public_token") @db.VarChar(64)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  columns     ProjectColumn[]
  tasks       Task[]
  milestones  Milestone[]
  nonWorkingDays NonWorkingDay[]

  @@index([ownerId, updatedAt])
  @@map("projects")
}

model Task {
  id           String    @id @default(uuid()) @db.Uuid
  projectId    String    @map("project_id") @db.Uuid
  parentId     String?   @map("parent_id") @db.Uuid
  orderIndex   Int       @map("order_index")
  level        Int       @default(0)
  title        String    @db.VarChar(200)
  workType     String?   @map("work_type") @db.VarChar(200)
  assignee     String    @db.VarChar(200)
  estimate     String?   @db.VarChar(100)
  comment      String?   @db.VarChar(1000)
  status       String    @default("Ожидает") @db.VarChar(30)
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  color        String    @default("sage") @db.VarChar(20)
  isCollapsed  Boolean   @default(false) @map("is_collapsed")
  customFields Json      @default("{}") @map("custom_fields")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent       Task?     @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Task[]    @relation("TaskHierarchy")

  @@index([projectId, orderIndex])
  @@index([parentId])
  @@map("tasks")
}

model ProjectColumn {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  name       String   @db.VarChar(80)
  key        String   @db.VarChar(40)
  orderIndex Int      @map("order_index")
  isVisible  Boolean  @default(true) @map("is_visible")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@unique([projectId, orderIndex])
  @@index([projectId])
  @@map("project_columns")
}

model Milestone {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  title     String   @db.VarChar(120)
  date      DateTime @db.Date
  color     String   @default("coral") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, date])
  @@map("milestones")
}

model NonWorkingDay {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  date      DateTime @db.Date
  label     String?  @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, date])
  @@index([projectId, date])
  @@map("non_working_days")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
